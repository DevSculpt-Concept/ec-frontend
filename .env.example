# Base URL of the EC REST API (include /api/v1, no trailing slash).
# Socket.IO and uploaded files are served from the same host.
# If this variable is not set, the production API is used.
VITE_API_URL=http://localhost:5001/api/v1

# Production:
# VITE_API_URL=https://api.curryfabulousfamily.com.ng/api/v1
